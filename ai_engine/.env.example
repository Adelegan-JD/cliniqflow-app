# CliniqFlow AI Engine environment

# Required for ASR authorization (Bearer token); this is not an OpenAI key.
AI_ENGINE_TOKEN=

# Offline ASR. The default model is LyngualLabs/whisper-small-yoruba and is
# already cached on this workstation. Point ASR_MODEL_PATH at a model folder
# when deploying it elsewhere.
ASR_MODEL_ID=LyngualLabs/whisper-small-yoruba
ASR_MODEL_PATH=
ASR_OFFLINE_ONLY=true

# Optional, only if pyannote has already been cached locally.
ASR_ENABLE_DIARIZATION=false

# CORS origins (comma-separated). Leave empty: only the backend should reach
# this internal service in production.
ALLOWED_ORIGINS=
