# CliniqFlow AI Engine environment

# Required for ASR authorization (Bearer token); this is not an OpenAI key.
AI_ENGINE_TOKEN=

# Offline ASR. The Docker image includes an int8 CTranslate2 conversion of the
# approved LyngualLabs/whisper-small-yoruba model; no API key is required.
ASR_MODEL_PATH=/opt/models/yoruba-whisper-small-ct2
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8

# The compact deployment deliberately runs one clinical-speaker stream.
ASR_ENABLE_DIARIZATION=false

# CORS origins (comma-separated). Leave empty: only the backend should reach
# this internal service in production.
ALLOWED_ORIGINS=
