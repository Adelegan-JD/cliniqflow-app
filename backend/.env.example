# CliniqFlow Backend environment

# Database
DATABASE_URL=postgresql+psycopg2://user:password@your-host/cliniqflow

# Supabase JWT verification
SUPABASE_URL=your supabase-url
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_JWT_ISSUER=
SUPABASE_JWKS_URL=
SUPABASE_JWT_VERIFY_AUD=true

# Supabase admin client (used for staff invites)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI engine orchestration
AI_ENGINE_URL=your-ai-engine-url
AI_ENGINE_TOKEN=change-me-in-production

# CORS
CORS_ORIGINS=

# Local JWT fallback (optional)
JWT_SECRET=
JWT_ISSUER=cliniqflow-backend
JWT_AUDIENCE=cliniqflow-client
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Password hashing
BCRYPT_ROUNDS=12

# Dev mode
CLINIQ_DEV_BYPASS_AUTH=true

# Backend port (optional override)
BACKEND_PORT=
